datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


// ====================
// MODEL DEFINITIONS
// ====================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String?   // Nullable for OAuth users
  image         String?   // Profile picture URL
  school        String?   // Kelas/sekolah SD (1-6)
  class         String?   // Kelas: "1", "2", "3", "4", "5", "6"

  // Progress tracking
  progress      Progress[]

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Level {
  id               String     @id @default(cuid())
  number           Int        @unique           // 1-20
  module           String     // "perkenalan", "bandingkan", "susun", "desimal"
  difficultyConfig  Json       // Config spesifik level

  // Progress tracking
  progress         Progress[]

  @@map("levels")
  @@unique([number, module])
}

model Progress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])

  levelId      String
  level        Level    @relation(fields: [levelId], references: [id])

  completed    Boolean  @default(false)
  completedAt  DateTime?

  // Future: stars, attempts, time spent
  // stars       Int      @default(0)

  @@map("progress")
  @@unique([userId, levelId])
}

